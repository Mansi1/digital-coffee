{
  "name": "rest-typescript-template",
  "version": "1.0.0",
  "description": "Hono REST API TypeScript template with feature-based structure",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:test": "DATABASE=postgresql://dev:dev@test-postgres:5433/dev prisma migrate deploy",
    "doc:dev": "vitepress dev docs",
    "doc:build": "vitepress build docs",
    "doc:preview": "vitepress preview docs",
    "docs:dev": "vitepress dev docs --host",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "@hono/zod-openapi": "1.2.4",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "@scalar/hono-api-reference": "0.7.0",
    "argon2": "0.44.0",
    "dotenv": "17.3.1",
    "hono": "4.7.4",
    "prisma": "7.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "22.0.0",
    "husky": "9.1.7",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitepress": "1.6.4",
    "vitest": "3.1.1"
  }
}
